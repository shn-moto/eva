# /etc/eva/secrets.env on the Station (chmod 600). KEY=value, one per line. Never in git.

# Claude: the answers (app/core/llm.py)
ANTHROPIC_API_KEY=sk-ant-...
# xAI text-to-speech: her voice (app/say.py); the voice id
XAI_API_KEY=xai-...
XAI_VOICE=eve
# Telegram bot: the text channel (app/telegram.py)
TELEGRAM_BOT_TOKEN=123456789:AA...
# Postgres on the hub: long-term memory and the shipped logs (app/memory.py, app/logship.py)
ASSISTANT_PG_DSN=postgresql://assistant:PASSWORD@HUB:5432/assistant_memory
