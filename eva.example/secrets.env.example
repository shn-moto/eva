# /etc/eva/secrets.env on the Station (chmod 600). KEY=value, one per line. Never in git.

# Claude: the answers (app/core/llm.py)
ANTHROPIC_API_KEY=sk-ant-...
# xAI text-to-speech: her voice (app/say.py); the voice id
XAI_API_KEY=xai-...
XAI_VOICE=eve
# Telegram bot: the text channel (app/telegram.py)
TELEGRAM_BOT_TOKEN=123456789:AA...
# Postgres on the hub: long-term memory and the shipped logs (app/memory.py, app/logship.py)
ASSISTANT_PG_DSN=postgresql://assistant:PASSWORD@HUB:5432/assistant_memory
# databases Eva reads with SQL (profile "databases"): a READ-ONLY role, e.g.
#   CREATE ROLE eva_ro LOGIN PASSWORD '...'; ALTER ROLE eva_ro SET default_transaction_read_only = on;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO eva_ro;  -- then REVOKE what holds keys / passwords
HOME_DB_DSN=postgresql://eva_ro:PASSWORD@HUB:5433/home_power_meter
# pictures API of the skill artist (profile "artist".key; default SAM Grid)
GRID_KEY=sk-...
# ElevenLabs text-to-speech: a voice per avatar (profile "voices"); key rights: Text to Speech, Voices/Models/User read
ELEVENLABS_API_KEY=sk_...
