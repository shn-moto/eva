[Unit]
Description=Eva: say the system is up, once the face is on the screen
After=eva-ui.service network-online.target
Wants=eva-ui.service

[Service]
Type=oneshot
WorkingDirectory=/opt/eva/app
# a page connected to the UI server = the face is up; then give it its fade-in
ExecStartPre=/bin/sh -c 'for i in $(seq 120); do curl -sf http://127.0.0.1:8080/api/status | grep -q "pages.: [1-9]" && sleep 2 && exit 0; sleep 0.5; done; exit 1'
ExecStart=/opt/eva/venv/bin/python say.py "Система загружена. Я готова."

[Install]
WantedBy=multi-user.target
