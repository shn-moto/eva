[Unit]
Description=Eva: Telegram bot (her channel to the outside world)
After=eva-brain.service network-online.target
Wants=eva-brain.service network-online.target

[Service]
ExecStart=/opt/eva/venv/bin/python /opt/eva/app/telegram.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
