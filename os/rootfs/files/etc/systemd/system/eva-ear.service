[Unit]
Description=Eva: hearing - the raw mic stream to the hub (all processing there)
# the mic ADCs are set up by eva-sound, which needs the capture closed
After=eva-sound.service eva-body.service
Wants=eva-sound.service eva-body.service

[Service]
ExecStart=/opt/eva/venv/bin/python /opt/eva/app/ear.py
Nice=-5
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
