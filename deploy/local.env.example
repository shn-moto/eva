# Copy to deploy/local.env (not in git) and set your hosts and keys.
# Read by deploy/station.sh and deploy/linux.sh; environment variables win.

# the Station: root over SSH (dropbear), its private key
STATION=root@192.168.0.20
KEY=station1/debian_ed25519

# the hub: the server with the GPU that runs STT, router and music (docker)
HOST=user@192.168.0.10
HUB_KEY=~/.ssh/id_ed25519
